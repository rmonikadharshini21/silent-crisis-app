# Copy to .env and change these values. Local demo values only.
HOST=127.0.0.1
PORT=5000
BASE_URL=http://127.0.0.1:5000
COUNTDOWN_SECONDS=10
CONFIDENCE_THRESHOLD=0.6

# Admin account created on first start.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=ChangeMe-Demo-1

# Set COOKIE_SECURE=1 when serving over HTTPS.
COOKIE_SECURE=0

# Email alerts. If SMTP_HOST is empty, alerts appear on the contact page only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
